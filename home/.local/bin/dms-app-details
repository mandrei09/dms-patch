#!/usr/bin/python3
"""Describe one desktop app for the DMS launcher details pane, as JSON.

    usage: dms-app-details DESKTOP_ID [STARTUP_WM_CLASS] [EXEC]

Reports where the .desktop file lives (and whether a user copy shadows a
system one), where the app came from (apt / flatpak / snap / Homebrew /
local) with version and installed size, and which Hyprland windows belong to
it with their resident memory. Called by LauncherDetailsPane.qml (installed
by dms-launcher-patch); lives in $HOME so it survives dms updates.

Kept cheap: one dpkg/flatpak query and one `hyprctl clients -j`, no network.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")


def run(args, timeout=2):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def app_dirs():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
    dirs = [data_home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    for extra in (os.path.join(HOME, ".local/share/flatpak/exports/share"), "/var/lib/flatpak/exports/share", "/var/lib/snapd/desktop"):
        if extra not in dirs:
            dirs.append(extra)
    seen, out = set(), []
    for d in dirs:
        a = os.path.join(d, "applications")
        if d and a not in seen and os.path.isdir(a):
            seen.add(a)
            out.append(a)
    return out


def find_desktop(did):
    name = did if did.endswith(".desktop") else did + ".desktop"
    hits = []
    for a in app_dirs():
        p = os.path.join(a, name)
        if os.path.isfile(p):
            hits.append(p)
    return hits


def human(kib):
    try:
        b = float(kib) * 1024
    except (TypeError, ValueError):
        return ""
    for u in ("B", "KB", "MB", "GB"):
        if b < 1024:
            return f"{b:.0f} {u}" if u == "B" else f"{b:.1f} {u}"
        b /= 1024
    return f"{b:.1f} TB"


def program_argv(exec_line):
    """Exec line -> argv of the real program: drops field codes (%U) and an
    `env [-u VAR] [-i] [NAME=VAL]...` prefix, which many overrides use."""
    try:
        argv = [a for a in shlex.split(exec_line or "") if not a.startswith("%")]
    except ValueError:
        return []
    if argv and os.path.basename(argv[0]) == "env":
        argv = argv[1:]
        while argv:
            if argv[0] in ("-u", "--unset", "-C", "--chdir"):
                argv = argv[2:]
            elif argv[0].startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", argv[0]):
                argv = argv[1:]
            else:
                break
    return argv


def source_of(path, exec_line):
    real = os.path.realpath(path)
    if "/flatpak/" in real:
        fid = os.path.basename(path)[: -len(".desktop")]
        info = run(["flatpak", "info", fid], timeout=3)
        get = lambda k: (re.search(rf"^\s*{k}:\s*(.+)$", info, re.M) or [None, ""])[1].strip()
        return {"kind": "Flatpak", "name": fid, "version": get("Version"), "size": get("Installed"), "origin": get("Origin")}
    if real.startswith("/var/lib/snapd/"):
        snap = os.path.basename(path).split("_")[0]
        line = run(["snap", "list", snap]).splitlines()[1:2]
        ver = line[0].split()[1] if line else ""
        return {"kind": "Snap", "name": snap, "version": ver}
    # dpkg owns system .desktop files; for a user override, ask about the
    # binary instead so the package is still named.
    candidates = [real]
    try:
        argv = program_argv(exec_line)
        binp = shutil.which(argv[0]) if argv else None
        if binp:
            candidates.append(os.path.realpath(binp))
    except ValueError:
        binp = None
    for c in candidates:
        if shutil.which("dpkg"):
            out = run(["dpkg", "-S", c])
            if out and ":" in out:
                pkg = out.split(":")[0].split(",")[0].strip()
                q = run(["dpkg-query", "-W", "-f", "${Version}\t${Installed-Size}", pkg]).split("\t")
                return {"kind": "apt", "name": pkg, "version": q[0] if q else "", "size": human(q[1]) if len(q) > 1 else ""}
        elif shutil.which("pacman"):
            # "/usr/bin/foo is owned by foo 1.2-1"
            m = re.search(r" is owned by (\S+) (\S+)$", run(["pacman", "-Qo", c]).strip())
            if m:
                info = run(["pacman", "-Qi", m.group(1)])
                size = re.search(r"^Installed Size\s*:\s*(.+)$", info, re.M)
                return {"kind": "pacman", "name": m.group(1), "version": m.group(2),
                        "size": size.group(1).replace(" ", "") if size else ""}
    for c in candidates[1:]:
        if c.startswith("/home/linuxbrew/"):
            return {"kind": "Homebrew", "name": os.path.basename(c)}
        if c.lower().endswith(".appimage") or "appimage" in c.lower():
            return {"kind": "AppImage", "name": c}
        if c.startswith("/opt/"):
            return {"kind": "Manual install", "name": "/opt/" + c.split("/")[2]}
        if c.startswith(HOME):
            return {"kind": "In home folder", "name": c.replace(HOME, "~", 1)}
    return {"kind": "Local .desktop" if path.startswith(HOME) else "Unknown"}


def rss_kib(pid):
    try:
        with open(f"/proc/{pid}/status") as f:
            m = re.search(r"^VmRSS:\s+(\d+)", f.read(), re.M)
            return int(m.group(1)) if m else 0
    except OSError:
        return 0


def tree(roots):
    kids = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        kids.setdefault(ppid, []).append(int(d))
    seen, stack = set(), list(roots)
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        stack.extend(kids.get(p, []))
    return seen


def windows(did, wmclass, exec_line):
    base = did[: -len(".desktop")] if did.endswith(".desktop") else did
    keys = {base.lower(), base.split(".")[-1].lower()}
    if wmclass:
        keys.add(wmclass.lower())
    argv = program_argv(exec_line)
    if argv:
        keys.add(os.path.basename(argv[0]).lower())
    keys.discard("")
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"]) or "[]")
    except ValueError:
        clients = []
    out = []
    for c in clients:
        cls = {str(c.get("class", "")).lower(), str(c.get("initialClass", "")).lower()}
        if cls & keys:
            ws = c.get("workspace", {}).get("name", "")
            out.append({"title": c.get("title", ""), "workspace": ws, "pid": c.get("pid", 0), "address": c.get("address", "")})
    return out


def main():
    if len(sys.argv) < 2 or not sys.argv[1]:
        print("{}")
        return
    did, wmclass = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "")
    exec_line = sys.argv[3] if len(sys.argv) > 3 else ""
    hits = find_desktop(did)
    res = {"desktop": hits[0] if hits else "", "shadows": hits[1] if len(hits) > 1 else ""}
    if hits:
        res["source"] = source_of(hits[-1] if hits[0].startswith(HOME) and len(hits) > 1 else hits[0], exec_line)
    wins = windows(did, wmclass, exec_line)
    res["windows"] = wins
    pids = sorted({w["pid"] for w in wins if w["pid"]})
    # Whole process tree: Electron/Chromium apps keep most memory in
    # renderer/GPU children, so the window's own pid badly undercounts.
    res["memory"] = human(sum(rss_kib(p) for p in tree(pids))) if pids else ""
    res["processes"] = len(tree(pids)) if pids else 0
    print(json.dumps(res))


# Imported by dms-launcher-action for windows()/tree(); only run as a script.
if __name__ == "__main__":
    main()
