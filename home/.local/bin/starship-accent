#!/usr/bin/env bash
# Regenerate Starship's accent colour from the live GTK accent.
#
# Same source of truth as ghostty-accent / kitty-accent (accent-resolve.py
# --print), called from hypr-accent. The tracked config
# (~/.config/starship.toml -> dotfiles) carries a placeholder
# [palettes.accent]; this writes a copy with the real accent to
# ~/.cache/starship/starship.toml, which ~/.zshrc uses as STARSHIP_CONFIG.
# Starship re-reads its config on every prompt, so open shells pick it up on
# their next prompt -- nothing to reload.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
BASE="$HOME/.config/starship.toml"
OUT="$HOME/.cache/starship/starship.toml"

hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')
mkdir -p "${OUT%/*}"
{
    echo "# GENERATED by starship-accent from $BASE -- edit that file instead."
    sed "/^\[palettes\.accent\]/,/^\[/ s/^accent = .*/accent = \"#$hex\"/" "$BASE"
} > "$OUT.tmp"
mv -f "$OUT.tmp" "$OUT"
echo "starship accent #$hex"
