#!/usr/bin/env bash
# Regenerate accent-derived colour fragments from the DMS palette.
#
# Single source of truth is accent-resolve.py, which reads DankMaterialShell's
# live palette (~/.cache/DankMaterialShell/dms-colors.json): whatever is
# picked in DMS Settings -> Theme & Colors is what the whole system uses.
# Re-run by hypr-accent-sync.service (gsettings) and hypr-accent.path (DMS).
#
# Does nothing unless the colours actually changed (or --force): the DMS files
# the .path unit watches are rewritten constantly for unrelated reasons, and
# every pass here regenerates accent.conf and reloads Hyprland, Ghostty and
# tmux -- that was 40+ config reloads in half an hour.
set -euo pipefail

RESOLVE="$HOME/.local/bin/accent-resolve.py"
install -d "$HOME/.cache/accent"
pal=$("$RESOLVE" --all)
key=$(printf '%s|%s|%s' "$pal" \
    "$(gsettings get org.gnome.desktop.interface gtk-theme)" \
    "$(gsettings get org.gnome.desktop.interface icon-theme)" | md5sum | cut -d' ' -f1)
stamp="$HOME/.cache/accent/applied.key"
if [ "${1:-}" != "--force" ] && [ -f "$HOME/.config/hypr/accent.conf" ] \
        && [ "$(cat "$stamp" 2>/dev/null)" = "$key" ]; then
    exit 0
fi

hex=$("$RESOLVE" --print | tr -d '#[:space:]')

# One shared palette (dms-colors.json shape, custom-theme colours applied) for
# the quickshell overlays (snip, altswitcher), which watch it.
# Written in place, not replaced, so their file watches stay attached.
printf '%s\n' "$pal" > "$HOME/.cache/accent/palette.json"

read -r dim inactive <<EOF
$(/usr/bin/python3 - "$hex" <<'PY'
import sys
h = sys.argv[1]
r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
mix = lambda c, t, w: round(c * (1 - w) + t * w)
# 0.45 toward black: the gradient partner for the active border.
dim = '%02X%02X%02X' % tuple(mix(c, 0x00, 0.45) for c in (r, g, b))
# 0.80 toward ubuntu-dock's #131313: a desaturated inactive border that
# still reads as related to the accent.
inactive = '%02X%02X%02X' % tuple(mix(c, 0x13, 0.80) for c in (r, g, b))
print(dim, inactive)
PY
)
EOF

install -d "$HOME/.config/hypr"

cat > "$HOME/.config/hypr/accent.conf" <<EOF
# GENERATED by hypr-accent -- edits are lost on the next run.
\$accent    = rgb($hex)
\$accentDim = rgb($dim)
\$inactive  = rgb($inactive)
\$accentA   = rgba(${hex}cc)
EOF

# NOTE: waybar and mako were retired in favour of DMS, which owns the bar
# and org.freedesktop.Notifications. Their accent.css / border-color blocks
# lived here. DMS is now the accent source itself (see the header).

# GNOME's named accent-color, plus the Yaru icon/GTK theme variant, nearest
# to the DMS primary (Adwaita's folders and GTK 3 selection are fixed blue).
# Runs before the settings.ini sync below so both pick up the new themes.
if [ -x "$HOME/.local/bin/gnome-accent" ]; then
    "$HOME/.local/bin/gnome-accent" >/dev/null 2>&1 || true
fi

# Keep the GTK settings.ini files (shared with GNOME) in step with the
# live theme, so switching accent in GNOME Settings can never leave them
# pointing at a stale Yaru variant.
theme=$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")
icons=$(gsettings get org.gnome.desktop.interface icon-theme | tr -d "'")
for f in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    [ -f "$f" ] || continue
    sed -i -e "s/^gtk-theme-name=.*/gtk-theme-name=$theme/" \
           -e "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/" "$f"
done

# DMS used to be rebuilt from the GTK accent here (hypr-dms-accent). It is now
# the SOURCE, so feeding its colour back into it would loop.

# Append DMS's Material surface colours to accent.conf, so Hyprland-side UI
# such as the Hyprspace overview can match DMS's panels.
# Drop any block a concurrent run already appended, so it is never duplicated.
sed -i '/^# DMS surfaces/,$d' "$HOME/.config/hypr/accent.conf"
"$RESOLVE" --json | /usr/bin/python3 -c '
import json, sys
fallback = {"surface": "#181117", "surface_container": "#251d24",
            "surface_container_high": "#30272e", "outline": "#9e8b99"}
try:
    pal = json.load(sys.stdin)
except Exception:
    pal = {}
def hexof(n):
    return str(pal.get(n) or fallback[n]).lstrip("#")[:6]
print("# DMS surfaces (live DMS palette)")
for var, key, alpha in (("surface", "surface", ""), ("surfaceA", "surface", "f2"),
                        ("surfaceCont", "surface_container", ""),
                        ("surfaceContHigh", "surface_container_high", ""),
                        ("outline", "outline", "")):
    fn = "rgba" if alpha else "rgb"
    print("$%-15s = %s(%s%s)" % (var, fn, hexof(key), alpha))
# Groupbar pills: text on the accent, and DMS surfaces for the rest.
fallback.update({"on_accent": "#ffffff", "on_surface_variant": "#d5c1cf", "error": "#f2b8b5"})
print("# Groupbar pills")
print("$groupText         = rgb(%s)" % hexof("on_accent"))
print("$groupTextInactive = rgb(%s)" % hexof("on_surface_variant"))
print("$groupInactive     = rgba(%se6)" % hexof("surface_container_high"))
print("$groupLocked       = rgb(%s)" % hexof("error"))
' >> "$HOME/.config/hypr/accent.conf" || true

# Repaint Pulsar's user stylesheet from the same accent. Cheap and safe to run
# whether or not Pulsar is open -- it only rewrites the marked region of
# ~/.pulsar/styles.less. Note Pulsar does not hot-reload that file: an already
# open window keeps the old accent until it is reloaded or reopened.
if [ -x "$HOME/.local/bin/pulsar-accent" ]; then
    "$HOME/.local/bin/pulsar-accent" >/dev/null 2>&1 || true
fi

# Ghostty's split divider follows the accent too. Reloads the resident
# instance in place (SIGUSR2), so open windows pick it up.
if [ -x "$HOME/.local/bin/ghostty-accent" ]; then
    "$HOME/.local/bin/ghostty-accent" >/dev/null 2>&1 || true
fi

# kitty (second terminal) split divider follows the accent too, same as
# Ghostty's. Reloads running instances in place (SIGUSR1).
if [ -x "$HOME/.local/bin/kitty-accent" ]; then
    "$HOME/.local/bin/kitty-accent" >/dev/null 2>&1 || true
fi

# Starship prompt (directory + git branch) follows the accent too. Writes a
# generated config; shells pick it up on their next prompt.
if [ -x "$HOME/.local/bin/starship-accent" ]; then
    "$HOME/.local/bin/starship-accent" >/dev/null 2>&1 || true
fi

# tmux status bar and pane borders follow the accent too. Re-sources the
# config in a running server, so open sessions repaint in place.
if [ -x "$HOME/.local/bin/tmux-accent" ]; then
    "$HOME/.local/bin/tmux-accent" >/dev/null 2>&1 || true
fi

# Yazi's theme follows the accent too. Yazi only reads it at startup, so
# open instances keep the old colours until restarted.
if [ -x "$HOME/.local/bin/yazi-accent" ]; then
    "$HOME/.local/bin/yazi-accent" >/dev/null 2>&1 || true
fi

# GTK 4 / libadwaita apps (Nautilus, Satty, ...) take the accent from a
# generated ~/.config/gtk-4.0/gtk.css; Satty's pen palette leads with it.
# launcher-icons-accent: DMS launcher's generic folder/file icons.
for helper in gtk-accent satty-accent launcher-icons-accent; do
    if [ -x "$HOME/.local/bin/$helper" ]; then
        "$HOME/.local/bin/$helper" >/dev/null 2>&1 || true
    fi
done

# Live-reload consumers only if a session is actually running.
hyprctl reload >/dev/null 2>&1 || true

printf '%s\n' "$key" > "$stamp"
echo "accent #$hex  dim #$dim  inactive #$inactive"
