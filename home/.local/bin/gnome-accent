#!/usr/bin/python3 -I
"""gnome-accent -- point GNOME's accent settings at the nearest match for DMS.

org.gnome.desktop.interface accent-color is an enum of nine named colours
(libadwaita 1.6+, the portal's org.freedesktop.appearance accent-color, GNOME
Settings, Flatpak apps). It can't hold an arbitrary hex, so this picks the
named accent whose hue is closest to DankMaterialShell's live `primary`
(accent-resolve.py --json), or slate for a near-grey palette.

Icons and GTK 3 can't follow accent-color at all: Adwaita's folder icons and
its GTK 3 selection are a fixed blue. Yaru ships one theme per accent, so the
icon theme and GTK theme are switched to the nearest installed Yaru variant
(-dark in dark mode). Only an Adwaita or Yaru theme is replaced, never some
other theme picked by hand. DMS leaves the icon theme alone while its own
icon-theme setting is "System Default".

Run by hypr-accent. Writes only on a change. A changed icon/GTK theme makes
hypr-accent run once more (its change key includes them); this script is
idempotent, so that second pass settles.
"""
import colorsys
import json
import subprocess
import sys
from pathlib import Path

RESOLVE = Path.home() / ".local/bin/accent-resolve.py"

# libadwaita 1.6 accent colours (the light-mode "standalone" values).
GNOME = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a",
    "yellow": "#c88800", "orange": "#ed5b00", "red": "#e62d42",
    "pink": "#d56199", "purple": "#9141ac", "slate": "#6f8396",
}


# Yaru accent colours (yaru's accent-colors). Plain "Yaru" is the orange one.
YARU = {
    "Yaru": "#e95420", "Yaru-bark": "#787859", "Yaru-sage": "#657b69",
    "Yaru-olive": "#4b8501", "Yaru-viridian": "#03875b",
    "Yaru-prussiangreen": "#308280", "Yaru-blue": "#0073e5",
    "Yaru-purple": "#7764d8", "Yaru-magenta": "#b34cb3", "Yaru-red": "#da3450",
    "Yaru-wartybrown": "#b39169", "Yaru-yellow": "#c88800",
}
ICON_DIRS = [Path.home() / ".local/share/icons", Path.home() / ".icons", Path("/usr/share/icons")]
THEME_DIRS = [Path.home() / ".local/share/themes", Path.home() / ".themes", Path("/usr/share/themes")]


def hue_dist(a, b):
    d = abs(hls(a)[0] - hls(b)[0])
    return min(d, 1 - d)


def installed(name, dirs):
    return any((d / name).is_dir() for d in dirs)


def nearest_yaru(hexstr, dark, dirs):
    suffix = "-dark" if dark else ""
    have = [n for n in YARU if installed(n + suffix, dirs)]
    if not have:
        return None
    return min(have, key=lambda n: hue_dist(hexstr, YARU[n])) + suffix


def gget(key):
    return subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", key],
                          capture_output=True, text=True).stdout.strip().strip("'")


def gset(key, value):
    if gget(key) != value:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value],
                       check=True)


def ours(theme):
    """Adwaita or Yaru*: themes this script may replace."""
    return theme in ("Adwaita", "Adwaita-dark", "") or theme == "Yaru" or theme.startswith("Yaru-")


def hls(hexstr):
    h = hexstr.lstrip("#")[:6]
    return colorsys.rgb_to_hls(*(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)))


def nearest(hexstr):
    hue, _, sat = hls(hexstr)
    if sat < 0.12:
        return "slate"
    def dist(name):
        d = abs(hue - hls(GNOME[name])[0])
        return min(d, 1 - d)
    return min((n for n in GNOME if n != "slate"), key=dist)


def main():
    out = subprocess.run([sys.executable, "-I", str(RESOLVE), "--all"],
                         capture_output=True, text=True).stdout
    try:
        data = json.loads(out)
        dark = data.get("mode") != "light"
        primary = data["colors"]["dark" if dark else "light"].get("primary")
    except Exception:
        primary = None
    if not primary:
        print("gnome-accent: no DMS palette, leaving GNOME settings alone", file=sys.stderr)
        return 1
    accent = nearest(primary)
    icons = nearest_yaru(primary, dark, ICON_DIRS)
    gtk = nearest_yaru(primary, dark, THEME_DIRS)
    if "--print" in sys.argv:
        print(accent, icons or "-", gtk or "-")
        return 0
    gset("accent-color", accent)
    if icons and ours(gget("icon-theme")):
        gset("icon-theme", icons)
    if gtk and ours(gget("gtk-theme")):
        gset("gtk-theme", gtk)
    print(f"gnome accent {accent}, icons {gget('icon-theme')}, gtk {gget('gtk-theme')}"
          f" (DMS primary {primary})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
