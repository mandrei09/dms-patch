#!/usr/bin/python3 -I
"""gnome-accent -- point GNOME's accent-color at the nearest match for DMS.

org.gnome.desktop.interface accent-color is an enum of nine named colours
(libadwaita 1.6+, the portal's org.freedesktop.appearance accent-color, GNOME
Settings, Flatpak apps). It can't hold an arbitrary hex, so this picks the
named accent whose hue is closest to DankMaterialShell's live `primary`
(accent-resolve.py --json), or slate for a near-grey palette.

Run by hypr-accent. Writes only on a change; hypr-accent-watch sees the
accent-color flip but hypr-accent's change key ignores it, so no loop.
"""
import colorsys
import json
import subprocess
import sys
from pathlib import Path

RESOLVE = Path.home() / ".local/bin/accent-resolve.py"

# libadwaita 1.6 accent colours (the light-mode "standalone" values).
GNOME = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a",
    "yellow": "#c88800", "orange": "#ed5b00", "red": "#e62d42",
    "pink": "#d56199", "purple": "#9141ac", "slate": "#6f8396",
}


def hls(hexstr):
    h = hexstr.lstrip("#")[:6]
    return colorsys.rgb_to_hls(*(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)))


def nearest(hexstr):
    hue, _, sat = hls(hexstr)
    if sat < 0.12:
        return "slate"
    def dist(name):
        d = abs(hue - hls(GNOME[name])[0])
        return min(d, 1 - d)
    return min((n for n in GNOME if n != "slate"), key=dist)


def main():
    out = subprocess.run([sys.executable, "-I", str(RESOLVE), "--json"],
                         capture_output=True, text=True).stdout
    try:
        primary = json.loads(out).get("primary")
    except Exception:
        primary = None
    if not primary:
        print("gnome-accent: no DMS palette, leaving accent-color alone", file=sys.stderr)
        return 1
    want = nearest(primary)
    if "--print" in sys.argv:
        print(want)
        return 0
    cur = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "accent-color"],
                         capture_output=True, text=True).stdout.strip().strip("'")
    if cur != want:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "accent-color", want],
                       check=True)
    print(f"gnome accent {want} (DMS primary {primary})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
