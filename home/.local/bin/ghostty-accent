#!/usr/bin/env bash
# Regenerate Ghostty's accent-derived colours from the live GTK accent.
#
# Same source of truth as accent.conf, the DMS palette and pulsar-accent:
# accent-resolve.py --print. Called from hypr-accent. Writes a generated
# fragment that ~/.config/ghostty/config pulls in with `config-file`, then
# reloads the resident instance with SIGUSR2 -- never restart it, Claude Code
# and every other terminal live inside it.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')

cat > "$HOME/.config/ghostty/accent" <<EOF2
# GENERATED by ghostty-accent -- edits are lost on the next run.
split-divider-color = #$hex
EOF2

pkill -USR2 -x ghostty 2>/dev/null || true
echo "ghostty accent #$hex"
