#!/usr/bin/env bash
# Regenerate Yazi's theme from the live GTK accent.
#
# Same source of truth as accent.conf, the DMS palette, pulsar-accent,
# ghostty-accent and tmux-accent: accent-resolve.py --print. Called from
# hypr-accent. Writes ~/.config/yazi/theme.toml outright (Yazi has no
# include directive), so keep hand edits in this script, not the output.
# Yazi reads its theme at startup: open instances keep the old accent.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')

read -r ink dim txt edge <<EOF
$(/usr/bin/python3 - "$hex" <<'PY'
import sys
h = sys.argv[1]
r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
# Text drawn on top of the accent: whichever of white / near-black gives
# more WCAG contrast, so a pale accent never ends up with white text.
lin = lambda c: (c / 255) / 12.92 if c <= 10 else (((c / 255) + 0.055) / 1.055) ** 2.4
L = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
ink = 'FFFFFF' if (1.05 / (L + 0.05)) >= ((L + 0.05) / (0.0262 + 0.05)) else '1F1F1F'
# 0.70 toward the terminal background #1F1F1F: secondary / inactive chips.
mix = lambda c, t, w: round(c * (1 - w) + t * w)
dim = '%02X%02X%02X' % tuple(mix(c, 0x1F, 0.70) for c in (r, g, b))
# Accent used as *text* on the #1F1F1F background: same hue, lightness
# raised until it clears WCAG 4.5:1, so a dark accent stays readable.
import colorsys
lum = lambda rgb: sum(w * lin(c) for w, c in zip((0.2126, 0.7152, 0.0722), rgb))
con = lambda rgb: (lum(rgb) + 0.05) / (0.0137 + 0.05)
hh, ll, ss = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
ss = max(ss, 0.35) if ss > 0.05 else ss
t = (r, g, b)
while con(t) < 4.5 and ll < 1:
    ll = min(1, ll + 0.01)
    t = tuple(round(c * 255) for c in colorsys.hls_to_rgb(hh, ll, ss))
txt = '%02X%02X%02X' % t
# Borders: the text accent pulled halfway to the background -- visible but quiet.
edge = '%02X%02X%02X' % tuple(mix(c, 0x1F, 0.50) for c in t)
print(ink, dim, txt, edge)
PY
)
EOF

a="#$hex" k="#$ink" d="#$dim" t="#$txt" e="#$edge"
install -d "$HOME/.config/yazi"

cat > "$HOME/.config/yazi/theme.toml" <<EOF
# GENERATED by yazi-accent -- edits are lost on the next run.
# Only accent-related keys; everything else falls through to Yazi's preset.

[mgr]
cwd           = { fg = "$t" }
find_position = { fg = "$t", bg = "reset", bold = true, italic = true }
border_style  = { fg = "$e" }
# Code previews use the same Dark Modern palette as nvim.
syntect_theme = "~/.config/yazi/dark-modern.tmTheme"

[tabs]
active   = { fg = "$k", bg = "$a", bold = true }
inactive = { fg = "$t", bg = "$d" }

[mode]
normal_main = { fg = "$k", bg = "$a", bold = true }
normal_alt  = { fg = "$t", bg = "$d" }

[indicator]
parent  = { fg = "$t", bg = "$d" }
current = { fg = "$k", bg = "$a", bold = true }
preview = { underline = true }

[which]
border = { fg = "$t" }
desc   = { fg = "$t" }

[confirm]
border = { fg = "$t" }
title  = { fg = "$t" }

[spot]
border  = { fg = "$t" }
title   = { fg = "$t" }
tbl_col = { fg = "$t" }

[pick]
border = { fg = "$t" }
active = { fg = "$t", bold = true }

[input]
border = { fg = "$t" }

[cmp]
border = { fg = "$t" }
active = { fg = "$k", bg = "$a" }

[tasks]
border  = { fg = "$t" }
hovered = { fg = "$t", bold = true }

[help]
border  = { fg = "$t" }
chord   = { fg = "$t" }
hovered = { fg = "$k", bg = "$a", bold = true }

[filetype]
# Preset rules, except directories take the accent instead of blue.
rules = [
	{ mime = "**/image/*", fg = "yellow" },
	{ mime = "**/{audio,video}/*", fg = "magenta" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "red" },
	{ mime = "**/application/{pdf,doc,rtf}", fg = "cyan" },
	{ mime = "vfs/{absent,stale}", fg = "gray" },
	{ url = "*", is = "orphan", bg = "red" },
	{ url = "*", is = "exec", fg = "green" },
	{ url = "*", is = "dummy", bg = "red" },
	{ url = "*/", is = "dummy", bg = "red" },
	{ url = "*/", fg = "$t", bold = true },
]
EOF

echo "yazi accent #$hex  ink #$ink  dim #$dim  text #$txt  edge #$edge"
