#!/bin/sh
# gtk-accent -- point GTK 4 / libadwaita apps at the DMS accent.
# Writes ~/.config/gtk-4.0/gtk.css, which every GTK 4 app loads on start
# (open windows keep the old colour until reopened). Called from hypr-accent.
set -eu
pal=$("$HOME/.local/bin/accent-resolve.py" --json)
get() { printf %s "$pal" | jq -r --arg k "$1" '.[$k] // empty'; }
accent=$(get accent)
on_accent=$(get on_accent)
[ -n "$accent" ] || exit 1
[ -n "$on_accent" ] || on_accent="#000000"
mkdir -p "$HOME/.config/gtk-4.0"
cat > "$HOME/.config/gtk-4.0/gtk.css" <<CSS
/* GENERATED by gtk-accent from the DMS palette -- edits are lost. */
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $on_accent;
:root {
  --accent-color: $accent;
  --accent-bg-color: $accent;
  --accent-fg-color: $on_accent;
}
CSS
