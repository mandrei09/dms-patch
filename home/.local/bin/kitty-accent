#!/usr/bin/env bash
# Regenerate kitty's accent-derived colours from the live GTK accent.
#
# kitty twin of ghostty-accent: same source of truth (accent-resolve.py
# --print), called from hypr-accent. Writes the fragment kitty.conf pulls in
# with `include accent.conf`, then asks running kitty instances to reload
# their config in place (SIGUSR1) -- never restart them.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')

mkdir -p "$HOME/.config/kitty"
cat > "$HOME/.config/kitty/accent.conf" <<EOF2
# GENERATED by kitty-accent -- edits are lost on the next run.
active_border_color #$hex
bell_border_color   #$hex
EOF2

pkill -USR1 -x kitty 2>/dev/null || true
echo "kitty accent #$hex"
