#!/usr/bin/python3
"""Extra right-click / Right-arrow actions for the DMS launcher.

    dms-launcher-action menu file PATH
    dms-launcher-action menu app DESKTOP_ID [WM_CLASS] [EXEC]
    dms-launcher-action do ACTION ARGS...
    dms-launcher-action uninstall-plan DESKTOP_ID   (JSON: what would be removed; removes nothing)
    dms-launcher-action uninstall-run PLAN_JSON

`menu` prints JSON that LauncherExtraActions.qml (installed by
dms-launcher-patch) turns into menu entries: the apps registered for a
file's MIME type, whether it is text / an archive, the folder's git remote,
or an app's open windows and the current workspaces. `do` carries out one
action. Lives in $HOME so it survives dms updates; /usr/bin/python3 on
purpose -- Homebrew's python3 has no `gi`.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import urllib.parse

HOME = os.path.expanduser("~")
ARCHIVE_EXT = (".zip", ".tar", ".tar.gz", ".tgz", ".tar.xz", ".txz", ".tar.bz2", ".tbz2",
               ".tar.zst", ".tzst", ".7z", ".rar", ".gz", ".xz", ".bz2", ".zst", ".jar", ".deb", ".rpm", ".iso")
TEXT_MIME_EXTRA = ("application/json", "application/xml", "application/javascript",
                   "application/x-shellscript", "application/x-desktop", "application/toml",
                   "application/x-yaml", "application/sql", "inode/x-empty")
COPY_MAX = 5 * 1024 * 1024


def app_details():
    """dms-app-details as a module (window matching + process tree)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "dms-app-details")
    loader = importlib.machinery.SourceFileLoader("dms_app_details", path)
    spec = importlib.util.spec_from_loader("dms_app_details", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def run(args, timeout=3, cwd=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, cwd=cwd).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def spawn(args, cwd=None):
    subprocess.Popen(args, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def notify(summary, body=""):
    spawn(["notify-send", "-a", "Launcher", "-i", "system-search", summary, body])


def mime_of(path):
    return run(["file", "-b", "--mime-type", "--", path])


def is_text(mime):
    return mime.startswith("text/") or mime in TEXT_MIME_EXTRA


def is_archive(path):
    low = path.lower()
    return any(low.endswith(e) for e in ARCHIVE_EXT)


def git_info(path):
    d = path if os.path.isdir(path) else os.path.dirname(path)
    top = run(["git", "-C", d, "rev-parse", "--show-toplevel"])
    if not top:
        return None
    remote = run(["git", "-C", d, "remote", "get-url", "origin"])
    if not remote:
        names = run(["git", "-C", d, "remote"]).split()
        remote = run(["git", "-C", d, "remote", "get-url", names[0]]) if names else ""
    return {"top": top, "branch": run(["git", "-C", d, "branch", "--show-current"]),
            "remote": remote, "web": web_url(remote)}


def web_url(remote):
    """git@github.com:me/x.git / ssh://git@host:22/me/x / https://... -> https://host/me/x"""
    r = remote.strip()
    if not r:
        return ""
    m = re.match(r"^[\w.-]+@([\w.-]+):(?!\d+/)(.+)$", r)
    if m:
        host, path = m.groups()
    else:
        m = re.match(r"^(?:ssh|git|https?)://(?:[^@/]+@)?([\w.-]+)(?::\d+)?/(.+)$", r)
        if not m:
            return ""
        host, path = m.groups()
    path = re.sub(r"\.git/?$", "", path)
    return f"https://{host}/{path}"


def open_with(path):
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
    except (ImportError, ValueError):
        return []
    ctype = Gio.content_type_guess(path, None)[0] if not os.path.isdir(path) else "inode/directory"
    return open_with_type(ctype)


def open_with_type(ctype):
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
    except (ImportError, ValueError):
        return []
    default = Gio.AppInfo.get_default_for_type(ctype, False)
    out, seen = [], set()
    apps = ([default] if default else []) + list(Gio.AppInfo.get_all_for_type(ctype))
    for a in apps:
        aid = a.get_id() or ""
        if not aid or aid in seen or not a.should_show():
            continue
        seen.add(aid)
        out.append({"id": aid, "name": a.get_display_name() or a.get_name(), "default": a is default})
    return out


def menu_file(path):
    res = {"path": path, "isDir": os.path.isdir(path)}
    if res["isDir"]:
        res["git"] = git_info(path)
        return res
    mime = mime_of(path)
    res["mime"] = mime
    res["text"] = is_text(mime) and os.path.getsize(path) <= COPY_MAX
    res["archive"] = is_archive(path)
    res["openWith"] = open_with(path)
    return res


def menu_app(did, wmclass, exec_line):
    mod = app_details()
    hits = mod.find_desktop(did)
    wins = mod.windows(did, wmclass, exec_line)
    try:
        ws = json.loads(run(["hyprctl", "workspaces", "-j"]) or "[]")
    except ValueError:
        ws = []
    ws = sorted(({"id": w.get("id"), "name": str(w.get("name", "")), "windows": w.get("windows", 0)}
                 for w in ws if isinstance(w.get("id"), int) and w["id"] > 0), key=lambda w: w["id"])
    pids = sorted({w["pid"] for w in wins if w.get("pid")})
    return {"desktop": hits[0] if hits else "", "windows": wins, "workspaces": ws,
            "processes": len(mod.tree(pids)) if pids else 0}


def tmux_name(path):
    return re.sub(r"[.:\s]+", "_", os.path.basename(path.rstrip("/")) or "root")


def do(action, args):
    a = args + [""] * 3
    p = a[0]
    if action == "show-in-files":
        spawn(["nautilus", "--select", p])
    elif action == "vscode":
        spawn(["code", p])
    elif action == "nvim":
        # New terminal window (xdg-terminal-exec -> Ghostty +new-window),
        # started in the file's folder so LazyVim picks the right project
        # root. cd inside the shell: Ghostty's single instance ignores
        # --working-directory. nvim is brew's, linked into ~/.local/bin.
        nvim = shutil.which("nvim") or os.path.join(HOME, ".local/bin/nvim")
        # `set title` so the window is named after the file, not "sh".
        # Own systemd scope: if Ghostty is not running yet, the instance this
        # starts would otherwise live in dms.service's cgroup and die on the
        # next DMS restart.
        scope = ["systemd-run", "--user", "--scope", "--quiet", "--"] if shutil.which("systemd-run") else []
        spawn(scope + ["xdg-terminal-exec", "sh", "-c", 'cd -- "$1" && exec "$2" --cmd "set title" -- "$3"', "sh",
               os.path.dirname(p) or "/", nvim, p])
    elif action == "open-with":
        # args: DESKTOP_ID PATH
        spawn(["gtk-launch", a[0], a[1]])
    elif action == "edit":
        # The default text editor, NOT xdg-open: opening a .desktop file
        # that way can run the app instead of showing its source.
        apps = open_with_type("text/plain")
        if apps:
            spawn(["gtk-launch", apps[0]["id"], p])
    elif action == "copy-file":
        uri = "file://" + urllib.parse.quote(p)
        subprocess.run(["wl-copy", "-t", "text/uri-list"], input=uri + "\r\n", text=True)
        notify("File copied", os.path.basename(p))
    elif action == "copy-contents":
        if os.path.getsize(p) > COPY_MAX:
            notify("Not copied", "File is larger than 5 MB")
            return
        with open(p, "rb") as f:
            subprocess.run(["wl-copy", "-t", "text/plain;charset=utf-8"], stdin=f)
        notify("Contents copied", os.path.basename(p))
    elif action == "trash":
        if subprocess.run(["gio", "trash", "--", p]).returncode == 0:
            notify("Moved to Trash", p.replace(HOME, "~", 1))
        else:
            notify("Could not move to Trash", p.replace(HOME, "~", 1))
    elif action == "extract":
        spawn(["file-roller", "--extract-here", p])
    elif action == "tmux":
        spawn(["xdg-terminal-exec", "tmux", "new-session", "-A", "-s", tmux_name(p), "-c", p])
    elif action == "git-web":
        g = git_info(p)
        if g and g["web"]:
            spawn(["xdg-open", g["web"]])
    elif action == "focus":
        run(["hyprctl", "dispatch", "focuswindow", "address:" + p])
    elif action in ("quit", "force-quit"):
        # args: DESKTOP_ID WM_CLASS EXEC
        mod = app_details()
        wins = mod.windows(a[0], a[1], a[2])
        if action == "quit":
            for w in wins:
                if w.get("address"):
                    run(["hyprctl", "dispatch", "closewindow", "address:" + w["address"]])
            return
        procs = mod.tree(sorted({w["pid"] for w in wins if w.get("pid")}))
        procs.discard(os.getpid())
        for pid in procs:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        notify("Force quit", f"Killed {len(procs)} processes")
    elif action == "workspace":
        run(["hyprctl", "dispatch", "workspace", p])
    else:
        print(f"unknown action: {action}", file=sys.stderr)
        sys.exit(2)


# ── uninstall, whatever the source ──────────────────────────────────────
# uninstall-plan works out WHAT would be removed and HOW; the launcher shows
# its title/message in DMS's own confirm dialog, then hands the plan back to
# uninstall-run. Nothing is removed by uninstall-plan. All root steps run in
# ONE pkexec call (one password prompt); user-owned files go to the Trash.
APP_ROOT_PARENTS = ("Games", "Applications", "apps", "Apps", "opt", ".local/opt")


def tilde(p):
    return p.replace(HOME, "~", 1) if p.startswith(HOME) else p


def desktop_field(path, key):
    try:
        in_entry = False
        for ln in open(path, errors="replace"):
            ln = ln.strip()
            if ln.startswith("["):
                in_entry = ln == "[Desktop Entry]"
            elif in_entry and ln.startswith(key + "="):
                return ln[len(key) + 1:]
    except OSError:
        pass
    return ""


def remove_file_step(path):
    """Trash what we own; rm (as root) what we don't."""
    if path.startswith(HOME + "/"):
        return {"argv": ["gio", "trash", "--", path], "root": False}
    return {"argv": ["rm", "-rf", "--", path], "root": True}


def uninstall_plan(did):
    mod = app_details()
    hits = mod.find_desktop(did)
    if not hits:
        return {"error": "No .desktop file found for " + did}
    desk = hits[0]
    name = desktop_field(desk, "Name") or did
    exec_line = desktop_field(desk, "Exec")
    steps, lines = [], []
    title = "Uninstall " + name + "?"

    # Chromium-family web app (PWA): its binary belongs to the browser's
    # package, so "uninstalling the package" would remove the whole browser.
    if re.search(r"--app-id=|--app=", exec_line) and desk.startswith(HOME):
        return {"kind": "Web app", "title": "Remove web app " + name + "?",
                "message": "Removes the web app's launcher (" + tilde(desk) + ").\nThe browser itself stays installed.",
                "steps": [remove_file_step(desk)]}

    # A user .desktop that shadows a system one is an override: uninstall the
    # app it overrides, and drop the override too.
    src_desk = desk
    if desk.startswith(HOME) and len(hits) > 1:
        src_desk = hits[1]
        steps.append(remove_file_step(desk))
        lines.append("Your launcher override " + tilde(desk) + " is moved to the Trash.")
    src = mod.source_of(src_desk, desktop_field(src_desk, "Exec") or exec_line)
    kind = src.get("kind", "Unknown")
    sname = src.get("name", "")

    if kind == "Flatpak":
        steps.insert(0, {"argv": ["flatpak", "uninstall", "-y", "--noninteractive", "--app", sname], "root": False})
        lines.insert(0, "Flatpak app " + sname + (" " + src["version"] if src.get("version") else "") + " is uninstalled (its data in ~/.var/app stays).")
    elif kind == "Snap":
        steps.insert(0, {"argv": ["snap", "remove", sname], "root": True})
        lines.insert(0, "Snap " + sname + " is removed.")
    elif kind == "apt":
        sim = run(["apt-get", "-s", "remove", sname], timeout=20)
        removed = re.findall(r"^Remv (\S+)", sim, re.M)
        if not removed:
            return {"error": "apt would not remove " + sname + ":\n" + "\n".join(sim.splitlines()[-3:])}
        steps.insert(0, {"argv": ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "remove", "-y", sname], "root": True})
        others = [r for r in removed if r != sname]
        lines.insert(0, "apt package " + sname + " is removed" + (", together with " + str(len(others)) + " package(s) that depend on it:\n  " + ", ".join(others) if others else ".") )
    elif kind == "Homebrew":
        argv = mod.program_argv(desktop_field(src_desk, "Exec") or exec_line)
        real = os.path.realpath(shutil.which(argv[0]) or argv[0]) if argv else ""
        m = re.search(r"/Cellar/([^/]+)/", real)
        formula = m.group(1) if m else sname
        steps.insert(0, {"argv": ["/home/linuxbrew/.linuxbrew/bin/brew", "uninstall", formula], "root": False})
        lines.insert(0, "Homebrew formula " + formula + " is uninstalled.")
    elif kind == "AppImage":
        steps.insert(0, remove_file_step(sname))
        lines.insert(0, "The AppImage " + tilde(sname) + " is deleted.")
        if src_desk == desk:
            steps.append(remove_file_step(desk))
            lines.append("Its launcher " + tilde(desk) + " is removed.")
    elif kind == "Manual install":
        steps.insert(0, {"argv": ["rm", "-rf", "--", sname], "root": True})
        lines.insert(0, "The folder " + sname + " is deleted.")
        if src_desk == desk:
            steps.append(remove_file_step(desk))
            lines.append("Its launcher " + tilde(desk) + " is removed.")
    elif kind == "In home folder":
        prog = os.path.expanduser(sname)
        rel = os.path.relpath(prog, HOME).split(os.sep)
        target = prog
        for par in APP_ROOT_PARENTS:
            pp = par.split("/")
            if rel[:len(pp)] == pp and len(rel) > len(pp) + 1:
                target = os.path.join(HOME, *rel[:len(pp) + 1])
                break
        if any(d in os.path.realpath(prog) for d in ("/dotfiles/", "/dms-patch/")) or target in (HOME, HOME + "/"):
            target = None
        if target:
            steps.insert(0, remove_file_step(target))
            lines.insert(0, ("The folder " if os.path.isdir(target) else "The program ") + tilde(target) + " is moved to the Trash.")
        if src_desk == desk:
            steps.append(remove_file_step(desk))
            lines.append("Its launcher " + tilde(desk) + " is removed.")
    else:
        if not desk.startswith(HOME):
            argv = mod.program_argv(exec_line)
            binp = shutil.which(argv[0]) if argv else None
            if binp and binp.startswith("/usr/local/"):
                steps = [{"argv": ["rm", "-f", "--", binp], "root": True}, remove_file_step(desk)]
                lines = ["The program " + binp + " and its launcher " + desk + " are deleted."]
            else:
                return {"error": "Can't tell how " + name + " was installed, so there is nothing safe to remove.\n" + desk}
        else:
            steps = [remove_file_step(desk)]
            lines = ["Only the launcher " + tilde(desk) + " is removed: its install source could not be determined."]
    return {"kind": kind, "title": title, "message": "\n".join(lines), "steps": steps}


def uninstall_run(plan):
    steps = plan.get("steps") or []
    root = [s["argv"] for s in steps if s.get("root")]
    user = [s["argv"] for s in steps if not s.get("root")]
    errors = []
    if root:
        import shlex
        script = " && ".join(" ".join(shlex.quote(a) for a in argv) for argv in root)
        r = subprocess.run(["pkexec", "sh", "-c", script], capture_output=True, text=True)
        if r.returncode != 0:
            msg = "Authentication was cancelled." if r.returncode in (126, 127) else (r.stderr.strip().splitlines() or ["exit " + str(r.returncode)])[-1]
            print(msg, file=sys.stderr)
            sys.exit(r.returncode or 1)
    for argv in user:
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode != 0:
            errors.append((r.stderr.strip().splitlines() or [" ".join(argv) + " failed"])[-1])
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)


def main():
    argv = sys.argv[1:]
    if len(argv) >= 3 and argv[0] == "menu" and argv[1] == "file":
        print(json.dumps(menu_file(argv[2]) if os.path.exists(argv[2]) else {}))
    elif len(argv) >= 3 and argv[0] == "menu" and argv[1] == "app":
        rest = argv[2:] + ["", ""]
        print(json.dumps(menu_app(rest[0], rest[1], rest[2])))
    elif len(argv) >= 2 and argv[0] == "uninstall-plan":
        print(json.dumps(uninstall_plan(argv[1])))
    elif len(argv) >= 2 and argv[0] == "uninstall-run":
        uninstall_run(json.loads(argv[1]))
    elif len(argv) >= 2 and argv[0] == "do":
        do(argv[1], argv[2:])
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
