# ── 15b. Hyprland: the context menu window asked for NO keyboard focus under
# the focus grab, so arrow keys stayed with the launcher's search field (and the
# host's handleKey() forwarding calls a function DContextMenu doesn't have).
# The menu window is already in the grab's window list, so OnDemand works.
d15b = open(dcm).read()
_old15b = """            if (PopoutManager.screenshotActive || CompositorService.useHyprlandFocusGrab)
                return WlrKeyboardFocus.None;
            return WlrKeyboardFocus.Exclusive;"""
_new15b = """            if (PopoutManager.screenshotActive)
                return WlrKeyboardFocus.None;
            // dms-launcher-patch 15b: take keys under the Hyprland focus grab too.
            if (CompositorService.useHyprlandFocusGrab)
                return WlrKeyboardFocus.OnDemand;
            return WlrKeyboardFocus.Exclusive;"""
if "dms-launcher-patch 15b" in d15b:
