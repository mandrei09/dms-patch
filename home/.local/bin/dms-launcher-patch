# ── 5. widen both launchers to fit the pane ───────────────────────────
# 2.0 has one host for spotlight and full; one expression picks the width.
m = open(modal).read()
PANE_EXTRA = FULL_PANE_W + 20
stock = "readonly property int modalWidth: Math.min(spotlight ? (_dmenuSizeOverride ? LauncherMetrics.sizeWidth(_dmenuSizeOverride) : LauncherMetrics.spotlightWidth) : baseWidth, screenWidth - LauncherMetrics.screenMargin)"
wide = f"readonly property int modalWidth: Math.min((spotlight ? (_dmenuSizeOverride ? LauncherMetrics.sizeWidth(_dmenuSizeOverride) : LauncherMetrics.spotlightWidth) : baseWidth) + {PANE_EXTRA}, screenWidth - LauncherMetrics.screenMargin)"
if wide in m:
    print("DLauncherV2ModalHost.qml:     already widened")
else:
    assert m.count(stock) == 1, "DLauncherV2ModalHost.qml: modalWidth line not found/unique"
    m = m.replace(stock, wide)
    backup(modal); open(modal, "w").write(m)
    print(f"DLauncherV2ModalHost.qml:     patched (width +{PANE_EXTRA})")
    changed = True

sys.exit(0 if changed else 10)
PY

# python exits 0 (changed) or 10 (nothing to do); anything else is a real
# failure -- an unhandled exception must not look like a clean no-op run.
if [ "$rc" -ne 0 ] && [ "$rc" -ne 10 ]; then
    echo "ERROR: patch step failed (exit $rc) -- see the traceback above." >&2
    echo "Files already written this run are backed up alongside them." >&2
    exit "$rc"
fi

if [ -n "${DMS_SHELL_SYNC:-}" ]; then
    # Called from dms-shell-sync as part of DMS startup -- restarting the unit
    # from inside its own ExecStartPre would recurse.
    :
elif [ "$rc" -eq 0 ] || [ "$pane_changed" -eq 1 ]; then
    echo "Restarting DMS..."
    systemctl --user --machine="${SUDO_USER:-$USER}@" restart dms.service 2>/dev/null \
        || echo "Could not restart automatically -- run: systemctl --user restart dms.service"
    echo "Done."
else
    echo "Nothing to do -- already patched."
fi
