if "numberedKeys" in d:
    print("DContextMenu.qml:             numbered keys already patched")
else:
    a_prop = "    property bool keyboardNavigable: false\n"
    a_keys = """                if (root.handleKeyHook(event)) {
                    event.accepted = true;
                    return;
                }
"""
    a_row = """                                        DIcon {
                                            name: menuItemDelegate.modelData?.icon ?? ""
                                            size: root.itemIconSize
                                            color: menuRow.iconColor
                                            anchors.verticalCenter: parent.verticalCenter
                                        }
"""
    # 2.1 restyle: sizes come from root.itemIconSize / itemSpacing / itemPadding.
    a_textw = "width: parent.width - (root.itemIconSize + root.itemSpacing) * (trailingIcon.visible ? 2 : 1)"
    a_width = "itemSpacing + (hasTrailingIcons ? itemIconSize + itemSpacing : 0)"
    for nm, a in (("keyboardNavigable prop", a_prop), ("key hook", a_keys), ("row icon", a_row), ("text width", a_textw), ("menu width", a_width)):
        assert d.count(a) == 1, f"patch 21: DContextMenu {nm} anchor not found/unique"
    d = d.replace(a_prop, a_prop + """    // patch 21: show 1-9, 0, a-z on entries; pressing one activates it.
    property bool numberedKeys: false
    // Width DKeycap takes for one character (its implicitHeight is 2x font).
    readonly property real _keyColW: numberedKeys ? Math.round(Theme.fontSizeSmall * 2) : 0

    function keyLabelFor(itemIndex) {
        if (itemIndex < 9)
            return String(itemIndex + 1);
        if (itemIndex === 9)
            return "0";
        if (itemIndex < 36)
            return String.fromCharCode(65 + itemIndex - 10);
        return "";
    }

    function itemIndexForKey(text) {
        if (!/^[0-9a-z]$/.test(text))
            return -1;
        if (text === "0")
            return 9;
        if (text >= "1" && text <= "9")
            return Number(text) - 1;
        return 10 + text.charCodeAt(0) - 97;
    }
""")
    d = d.replace(a_keys, a_keys + """                if (root.numberedKeys && !(event.modifiers & (Qt.ControlModifier | Qt.AltModifier | Qt.MetaModifier))) {
                    const ki = root.itemIndexForKey(String(event.text || "").toLowerCase());
                    if (ki >= 0 && ki < root.visibleItemCount) {
                        root.keyboardNavigation = true;
                        root.selectedMenuIndex = ki;
                        root.activateSelected();
                        event.accepted = true;
                        return;
                    }
                }
""")
    a_trail = """                                    DIcon {
                                        id: trailingIcon
"""
    assert d.count(a_trail) == 1, "patch 21: DContextMenu trailing icon anchor not found/unique"
    # Same pattern as DMS's own power menu (PowerMenuView): a DKeycap on the
    # right of the row, tinted with the row's content colour.
    d = d.replace(a_trail, """                                    DKeycap {
                                        visible: root.numberedKeys && text.length > 0
                                        text: root.keyLabelFor(menuItemDelegate.itemIndex)
                                        textColor: menuRow.selected ? menuRow.contentColor : Theme.onSurfaceVariant
                                        opacity: menuRow.itemEnabled ? 1 : 0.5
                                        anchors.right: parent.right
                                        anchors.rightMargin: root.itemPadding + (trailingIcon.visible ? root.itemIconSize + root.itemSpacing : 0)
                                        anchors.verticalCenter: parent.verticalCenter
                                    }

""" + a_trail)
    d = d.replace(a_textw, a_textw + " - (root.numberedKeys ? root._keyColW + root.itemSpacing : 0)")
    d = d.replace(a_width, a_width + " + (numberedKeys ? _keyColW + Theme.spacingL * 2 : 0)")
    backup(dcm21); open(dcm21, "w").write(d)
    print("DContextMenu.qml:             patched (numbered keys)")
    changed = True

l = open(ctxmenu).read()
