# ── 16. (upstream since 2.0) the full launcher's dropdowns register with
# the transient-surface tracker and hand focus back to the search field.

# ── 16b. a launcher popup must not end the launcher's focus grab ─────
# Registering the dropdowns (16) is not enough: Hyprland clears the focus
# grab the moment the dropdown's xdg_popup opens, even with the popup in the
# grab's window list (verified: onCleared fired with the tracker active, n=1).
# So when the grab clears while one of the launcher's own transient surfaces
# is up, keep the launcher open and re-arm the grab once they close. Clicks
# outside the launcher still close it -- the click-catcher handles those,
# not the grab.
grab_re = re.compile(r"(    HyprlandFocusGrab \{\n        id: focusGrab\n        windows: [^\n]+\n        active: ([^\n]+)\n\n?        onCleared: \{\n)(.*?\n        \}\n    \}\n)", re.S)
for path in (standalone, connected):
    name = os.path.basename(path)
    g = open(path).read()
    if "_grabLostToPopup" in g:
        print(f"{name}: popup-safe focus grab already patched")
        continue
    hits = grab_re.findall(g)
    assert len(hits) == 1, f"{name}: HyprlandFocusGrab block not found/unique"
    active_expr = hits[0][1]
    g = grab_re.sub(lambda mo: mo.group(1) + """            if (transientSurfaces.active || grabRearmTimer.running) {
                root._grabLostToPopup = true;
                return;
            }
""" + mo.group(3) + f"""
    property bool _grabLostToPopup: false

    // Re-arming in the same tick the popup closes gets the new grab
    // cleared at once (keyboard focus is still on the dying popup), so wait
    // for focus to settle back on the launcher first.
    Timer {{
        id: grabRearmTimer
        interval: 250
        onTriggered: {{
            if (transientSurfaces.active || !root.spotlightOpen)
                return;
            root._grabLostToPopup = false;
            focusGrab.active = false;
            focusGrab.active = Qt.binding(() => {active_expr});
        }}
    }}

    Connections {{
        target: transientSurfaces
        function onActiveChanged() {{
            if (transientSurfaces.active) {{
                grabRearmTimer.stop();
                return;
            }}
            if (root._grabLostToPopup)
                grabRearmTimer.restart();
        }}
    }}
""", g, count=1)
    backup(path); open(path, "w").write(g)
    print(f"{name}: patched (popup-safe focus grab)")
    changed = True

# ── 17. long file names / paths: one line, elided in the MIDDLE ───────
# Stock rows elide at the right, and only for plain text: once a query is
# typed the name becomes RichText (match in <b>), where Qt ignores both
# `elide` and `maximumLineCount`, so a long file name wrapped onto a second
# line and shoved the path out of the row. File rows now measure the PLAIN
# name/path with ElideMiddle -- the extension and the immediate parent
# folders stay visible -- and re-apply the match highlight to what is left.
# Paths are shown with ~ for $HOME. Other result types are untouched.
row = os.path.join(os.path.dirname(transformers), "Components", "LauncherRow.qml")
r = open(row).read()
if "_fileRowElide" in r:
    print("LauncherRow.qml:              already patched")
else:
    a_imp = 'import "../../../Common/htmlElide.js" as HtmlElide\n'
    a_prop = "    property int flatIndex: -1\n"
    a_name = '            text: root.item?._hName ?? root.item?.name ?? ""\n            textFormat: root.item?._hRich ? Text.RichText : Text.PlainText\n'
    a_sub = '            text: root.item?._hRich ? HtmlElide.elideRichText(root.item._hSub ?? "", textColumn._richBudget) : (root.item?.subtitle ?? "")\n            textFormat: root.item?._hRich ? Text.RichText : Text.PlainText\n'
    for nm, a in (("import", a_imp), ("flatIndex", a_prop), ("nameText", a_name), ("subText", a_sub)):
        assert r.count(a) == 1, f"LauncherRow.qml: {nm} anchor not found/unique"
    r = r.replace(a_imp, a_imp + "import Quickshell\n")
    r = r.replace(a_prop, a_prop + '''
    // patch 17 (_fileRowElide): file rows elide name and path in the middle.
    readonly property bool _isFileRow: item?.type === "file"
    readonly property string _subPlain: {
        const s = String(item?.subtitle ?? "");
        const h = Quickshell.env("HOME") || "";
        return _isFileRow && h && (s === h || s.startsWith(h + "/")) ? "~" + s.substring(h.length) : s;
    }
    // Bold the query match inside an already-elided plain string. The match
    // text comes from the controller's own <b>...</b> markup.
    function _rehighlight(plain, rich) {
        const esc = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        const m = /<b>([\\s\\S]*?)<\\/b>/.exec(String(rich || ""));
        if (!m)
            return esc(plain);
        const needle = HtmlElide.stripHtmlTags(m[1]).toLowerCase();
        const i = needle ? plain.toLowerCase().indexOf(needle) : -1;
        if (i < 0)
            return esc(plain);
        return esc(plain.substring(0, i)) + "<b>" + esc(plain.substring(i, i + needle.length)) + "</b>" + esc(plain.substring(i + needle.length));
    }
    readonly property bool _nameHasHit: _isFileRow && !!item?._hRich && /<b>/.test(item?._hName ?? "")
    readonly property bool _subHasHit: _isFileRow && !!item?._hRich && /<b>/.test(item?._hSub ?? "")

    TextMetrics {
        id: _fileRowElide
        font: nameText.font
        elide: Qt.ElideMiddle
        elideWidth: Math.max(1, textColumn.width)
        text: root._isFileRow ? String(root.item?.name ?? "") : ""
    }

    TextMetrics {
        id: _fileRowSubElide
        font: subText.font
        elide: Qt.ElideMiddle
        elideWidth: Math.max(1, textColumn.width)
        text: root._isFileRow ? root._subPlain : ""
    }
''')
    r = r.replace(a_name, '''            text: root._isFileRow ? (root._nameHasHit ? root._rehighlight(_fileRowElide.elidedText, root.item._hName) : _fileRowElide.elidedText) : (root.item?._hName ?? root.item?.name ?? "")
            textFormat: root._isFileRow ? (root._nameHasHit ? Text.RichText : Text.PlainText) : (root.item?._hRich ? Text.RichText : Text.PlainText)
''')
    r = r.replace(a_sub, '''            text: root._isFileRow ? (root._subHasHit ? root._rehighlight(_fileRowSubElide.elidedText, root.item._hSub) : _fileRowSubElide.elidedText) : (root.item?._hRich ? HtmlElide.elideRichText(root.item._hSub ?? "", textColumn._richBudget) : (root.item?.subtitle ?? ""))
            textFormat: root._isFileRow ? (root._subHasHit ? Text.RichText : Text.PlainText) : (root.item?._hRich ? Text.RichText : Text.PlainText)
''')
    backup(row); open(row, "w").write(r)
    print("LauncherRow.qml:              patched (middle-elided file names/paths)")
    changed = True

