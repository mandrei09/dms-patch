# ── 23. actions ordered by how likely they are to be picked ───────────
# One fixed ranking per result kind (file / folder / app), lowest index =
# most likely, set once by hand (user asked). The stock category grouping
# (separators) goes: the order IS the grouping now. Submenus keep their own
# order (Back first); plugin results keep the plugin's order. Unlisted
# entries (an app's own desktop actions such as "New Window") take the
# `@other` slot; anything destructive-looking that is unlisted sorts last.
l = open(ctxmenu).read()
if "_rankActions" in l:
    print("LauncherContextMenu.qml:      action ranking already patched")
else:
    a = "    menuItems: {\n"
    assert l.count(a) == 1, "patch 23: LauncherContextMenu menuItems anchor not found/unique"
    l = l.replace(a, """    // patch 23: entries ordered by likelihood (see _actionRank).
    menuItems: _rankActions(_rawMenuItems)

    // [label or label prefix, rank]. "@sub:" = only the submenu variant of
    // that label; "@other" = rank for anything unlisted. Longest match wins.
    readonly property var _actionRank: ({
            "file": [["Extract here", 1], ["Open in VS Code", 2], ["Open in Neovim", 3], ["Copy path", 4], ["Open folder", 5], ["Preview", 6], ["Show in Files", 7], ["@sub:Open with…", 8], ["Copy name", 9], ["Copy contents", 10], ["Copy file", 11], ["Open with…", 12], ["@other", 50], ["Move to Trash", 99]],
            "dir": [["Open in VS Code", 1], ["Open in terminal", 2], ["Copy path", 3], ["Open in tmux", 4], ["Open on ", 5], ["Open remote in browser", 5], ["Show in Files", 6], ["Open folder", 7], ["Copy remote URL", 8], ["Copy name", 9], ["Copy folder", 10], ["@sub:Open with…", 11], ["Open with…", 12], ["@other", 50]],
            "app": [["Focus window", 1], ["@other", 2], ["Launch on workspace…", 3], ["Launch", 4], ["Quit", 5], ["Launch on dGPU", 6], ["Copy launch command", 7], ["Open .desktop file", 8], ["Edit App", 9], ["Hide App", 10], ["Pin to Dock", 11], ["Unpin from Dock", 11], ["Force quit", 98], ["Uninstall", 99]]
        })

    // patch 25: actions that open a specific app show that app's icon.
    // [label prefix, icon spec] -- spec as LauncherExtraActions.resolveAppIcon.
    readonly property var _actionAppIcon: [
        ["Open in VS Code", "desktop:com.microsoft.VSCode|desktop:code|vscode"],
        ["Open in Neovim", "desktop:nvim|/home/linuxbrew/.linuxbrew/share/icons/hicolor/128x128/apps/nvim.png"],
        ["Show in Files", "desktop:org.gnome.Nautilus"],
        ["Open folder", "desktop:org.gnome.Nautilus"],
        ["Open in terminal", "desktop:com.mitchellh.ghostty"],
        ["Open in tmux", "desktop:com.mitchellh.ghostty"],
        ["Extract here", "desktop:org.gnome.FileRoller"],
        ["Open .desktop file", "desktop:org.gnome.TextEditor"],
        ["Launch on dGPU", "nvidia-settings"],
        ["Open on GitLab", "fileicon:gitlab.svg"],
        ["Open on Azure DevOps", "fileicon:azure.svg"],
        ["Open on Bitbucket", "fileicon:bitbucket.svg"],
        ["Open on GitHub", "desktop:brave-browser"],
        ["Open remote in browser", "desktop:brave-browser"],
        ["Focus window", "@app"],
        ["Launch on workspace", "@app"],
        ["Launch", "@app"]
    ]

    function _withAppIcon(e) {
        if (!e || e.type !== "item" || e.appIconValue !== undefined)
            return e;
        const t = String(e.text || "");
        let spec = "", len = -1;
        for (const r of _actionAppIcon)
            if (t.startsWith(r[0]) && r[0].length > len) {
                spec = r[1];
                len = r[0].length;
            }
        // An app's own desktop actions ("New Window"...) arrive with the
        // generic play_arrow glyph: they launch the app, so show its icon.
        if (!spec && item?.type === "app" && (e.icon || "play_arrow") === "play_arrow")
            spec = "@app";
        if (!spec || (spec === "@app" && item?.type !== "app"))
            return e;
        const v = extraActions.resolveAppIcon(spec, item);
        return v ? Object.assign({}, e, { appIconValue: v }) : e;
    }

    function _rankActions(list) {
        if (extraActions.subMenu || !item || !Array.isArray(list))
            return list;
        const cat = item.type === "file" ? (item.data?.is_dir ? "dir" : "file") : item.type === "app" && !item.isCore ? "app" : "";
        const table = _actionRank[cat];
        if (!table)
            return list;
        let other = 50;
        for (const r of table)
            if (r[0] === "@other")
                other = r[1];
        const rank = e => {
            const t = String(e.text || "");
            const isSub = e.extra?.kind === "submenu";
            let best = null, bestLen = -1;
            for (const r of table) {
                let k = r[0];
                if (k === "@other")
                    continue;
                if (k.startsWith("@sub:")) {
                    if (!isSub)
                        continue;
                    k = k.substring(5);
                } else if (isSub && table.some(x => x[0] === "@sub:" + k)) {
                    continue;
                }
                if (t.startsWith(k) && k.length > bestLen) {
                    best = r[1];
                    bestLen = k.length;
                }
            }
            if (best !== null)
                return best;
            return e.isDestructive ? 97 : other;
        };
        // "Open with…" twice (stock app-chooser dialog + our submenu): keep
        // the submenu, keep the dialog only when there is no submenu.
        const hasSubOpenWith = list.some(e => e.extra?.kind === "submenu" && String(e.text || "").startsWith("Open with"));
        return list.map((e, i) => ({ e: e, i: i }))
            .map(x => ({ e: _withAppIcon(x.e), i: x.i })) // patch 25
            .filter(x => x.e.type !== "separator")
            .filter(x => !(hasSubOpenWith && x.e.extra?.kind !== "submenu" && String(x.e.text || "").startsWith("Open with")))
            .sort((a, b) => (rank(a.e) - rank(b.e)) || (a.i - b.i))
            .map(x => x.e);
    }

    readonly property var _rawMenuItems: {
""")
    backup(ctxmenu); open(ctxmenu, "w").write(l)
    print("LauncherContextMenu.qml:      patched (actions ordered by likelihood)")
    changed = True

# ── 24. Uninstall for every install source, through DMS's own dialog ───
