# ── 19. learned ranking: query memory, recency, file re-rank, Top hit ──
# Library: LearnedRank.js (copied in above). Data: ~/.local/state/dms-launcher-learn.json.
#  a) every pick records (query, result); decays with a 14-day half-life
#  b) apps/plugins/settings: Scorer gets a `learned` bonus via getFrecencyForItem
#  c) files/folders: dsearch hits re-ranked by it (only under "Score" sort), and
#     files picked before that dsearch's top 20 missed are re-added (checked to
#     still exist first; not with an ext/folder filter active)
#  d) a "Top hit" section above everything when one result clearly stands out
lr_js = os.path.join(os.path.dirname(controller), "LearnedRank.js")
c = open(controller).read()
sc = open(os.path.join(os.path.dirname(controller), "Scorer.js")).read()
scorer = os.path.join(os.path.dirname(controller), "Scorer.js")
if "_learnPick" in c:
    print("Controller.qml:               learned ranking already patched")
elif not os.path.exists(lr_js):
    print("Controller.qml:               no LearnedRank.js -- stock ranking")
else:
    a_imp = 'import "ItemTransformers.js" as Transform\n'
    a_frec = '    function getFrecencyForItem(item) {\n'
    a_exec = '        if (item.type !== "app")\n            recordItemUsage(item);\n'
    a_files = '_applyFileSearchResults(aggregatedItems, effectiveType);'
    a_flat = 'flatModel = Scorer.flattenSections(newSections);'
    a_score = 'var usageBonus = frecencyData ? Math.min(frecencyData.usageCount * 50, Weights.frecency) : 0;'
    for nm, a, src in (("import", a_imp, c), ("getFrecencyForItem", a_frec, c), ("executeItem usage", a_exec, c), ("file apply", a_files, c), ("Scorer usageBonus", a_score, sc)):
        assert src.count(a) == 1, f"patch 19: {nm} anchor not found/unique"
    assert c.count(a_flat) >= 5, "patch 19: flattenSections sites changed"

    c = c.replace(a_imp, a_imp + 'import "LearnedRank.js" as Learned\n')
    c = c.replace(a_exec, '        _learnPick(item);\n' + a_exec)
    c = c.replace(a_files, '_learnFilesThenApply(aggregatedItems, effectiveType, fileQuery);')
    a_limit = "                limit: 20,\n                fuzzy: true,\n"
    assert c.count(a_limit) == 1, "patch 19: dsearch limit anchor not found/unique"
    c = c.replace(a_limit, "                limit: 60, // patch 19: room for folder priority to re-rank\n                fuzzy: true,\n")
    c = re.sub(r'(?m)^(\s*)flatModel = Scorer\.flattenSections\(newSections\);',
               lambda m: f"{m.group(1)}newSections = _withTopHit(newSections);\n{m.group(1)}flatModel = Scorer.flattenSections(newSections);", c)
    c = c.replace(a_frec, r'''    // ── patch 19: learned ranking (LearnedRank.js) ────────────────────
    FileView {
        id: _learnFile

        path: (Quickshell.env("HOME") || "") + "/.local/state/dms-launcher-learn.json"
        blockLoading: true
        onLoaded: Learned.load(_learnFile.text())
        onLoadFailed: error => Learned.load("{}")
    }

    // Query the Files/Folders sections on screen belong to (see _withTopHit).
    property string _fileSectionsQuery: ""

    // Folder priority, a plain JSON the user edits (no GUI); live-reloaded.
    FileView {
        id: _prioFile

        path: (Quickshell.env("HOME") || "") + "/.config/dms/launcher-folder-priority.json"
        blockLoading: true
        watchChanges: true
        onFileChanged: reload()
        onLoaded: Learned.loadPriority(_prioFile.text(), Quickshell.env("HOME") || "")
        onLoadFailed: error => Learned.loadPriority("{}", "")
    }

    function _learnPick(item) {
        if (!item || item.type === "plugin_browse" || item.type === "dmenu" || searchMode === "dmenu")
            return;
        if (Learned.record(searchQuery, item))
            _learnFile.setText(Learned.dump());
    }

    // File hits: re-add known files dsearch missed (after checking they still
    // exist), re-rank by learned use, then hand over to the stock apply.
    function _learnFilesThenApply(items, effectiveType, fileQuery) {
        const ver = _searchVersion;
        const finish = function (extra) {
            if (ver !== root._searchVersion)
                return;
            let all = extra.concat(items);
            if ((fileSearchSort || "score") === "score")
                all = Learned.rerankFiles(fileQuery, all);
            // dsearch is asked for 60 so prioritised folders can climb in;
            // show the best 20 files and 20 folders, as before.
            let nf = 0, nd = 0;
            all = all.filter(it => it.data?.is_dir ? (nd++ < 20) : (nf++ < 20));
            root._fileSectionsQuery = root.searchQuery;
            _applyFileSearchResults(all, effectiveType);
        };
        const have = {};
        for (let i = 0; i < items.length; i++)
            have[items[i].data?.path || items[i].id] = true;
        const cand = (fileSearchExt || fileSearchFolder) ? [] : Learned.knownFiles(fileQuery, effectiveType, 5).filter(k => !have[k.path]);
        if (cand.length === 0) {
            finish([]);
            return;
        }
        const dirOf = {};
        cand.forEach(k => dirOf[k.path] = k.dir);
        Proc.runCommand("launcher-learn-exists", ["sh", "-c", 'for p; do [ -e "$p" ] && printf "%s\\n" "$p"; done', "sh"].concat(cand.map(k => k.path)), function (stdout) {
            const extra = String(stdout || "").split("\n").filter(p => p && dirOf[p] !== undefined).map(p => transformFileResult({
                        path: p,
                        score: 0,
                        is_dir: dirOf[p]
                    }));
            finish(extra);
        }, 0, 1500);
    }

    // Lift the one result your history clearly points at into a "Top hit"
    // section above everything. Idempotent: an existing Top hit is first put
    // back where it came from, so every rebuild re-decides from scratch.
    function _withTopHit(secs) {
        if (!secs)
            return secs;
        // Stock bug: an async plugin refresh (and any re-run of performSearch)
        // rebuilds sections from apps+plugins only, wiping the Files/Folders
        // sections dsearch delivered for this same query -- files vanished
        // whenever an always-on plugin answered after dsearch. Carry them
        // (and a Top hit lifted out of them) over while the query matches.
        if (searchMode === "all" && _fileSectionsQuery === searchQuery && searchQuery && !secs.some(s => s.id === "files" || s.id === "folders")) {
            const keep = sections.filter(s => s.id === "files" || s.id === "folders" || (s.id === "tophit" && s._origin && (s._origin.sectionId === "files" || s._origin.sectionId === "folders")));
            if (keep.length) {
                secs = secs.filter(s => s.id !== "tophit" || !(s._origin && (s._origin.sectionId === "files" || s._origin.sectionId === "folders"))).concat(keep);
                secs.sort((a, b) => a.priority !== b.priority ? a.priority - b.priority : a.id.localeCompare(b.id));
            }
        }
        let out = [];
        let top = null;
        for (let i = 0; i < secs.length; i++) {
            if (secs[i].id === "tophit")
                top = secs[i];
            else
                out.push(secs[i]);
        }
        if (top && top._origin && top.items.length) {
            const o = top._origin;
            const k = Learned.keyFor(top.items[0]);
            let idx = out.findIndex(s => s.id === o.sectionId);
            if (idx < 0 && o.section) {
                out.push(o.section);
                out.sort((a, b) => a.priority !== b.priority ? a.priority - b.priority : a.id.localeCompare(b.id));
            } else if (idx >= 0 && !out[idx].items.some(x => Learned.keyFor(x) === k)) {
                const its = out[idx].items.slice();
                its.splice(Math.min(o.index, its.length), 0, top.items[0]);
                out[idx] = Object.assign({}, out[idx], {
                    items: its
                });
            }
        }
        if (searchMode === "dmenu" || !Learned.normQuery(searchQuery))
            return out;
        const keys = [];
        for (let i = 0; i < out.length; i++)
            for (let j = 0; j < out[i].items.length; j++)
                keys.push(Learned.keyFor(out[i].items[j]));
        const best = Learned.topHitKey(searchQuery, keys);
        if (!best)
            return out;
        for (let si = 0; si < out.length; si++) {
            const ii = out[si].items.findIndex(x => Learned.keyFor(x) === best);
            if (ii < 0)
                continue;
            if (si === 0 && ii === 0)
                return out; // already first: nothing to lift
            const sec = out[si];
            const it = sec.items[ii];
            const rest = sec.items.slice();
            rest.splice(ii, 1);
            const origin = {
                sectionId: sec.id,
                index: ii,
                section: rest.length === 0 ? sec : null
            };
            if (rest.length === 0)
                out.splice(si, 1);
            else
                out[si] = Object.assign({}, sec, {
                    items: rest
                });
            out.unshift({
                id: "tophit",
                title: "Top hit",
                icon: "star",
                priority: 0,
                items: [it],
                collapsed: false,
                flatStartIndex: 0,
                _origin: origin
            });
            return out;
        }
        return out;
    }

    function getFrecencyForItem(item) {
        let f = _stockFrecency(item);
        const lb = Learned.scorerBonus(searchQuery, item);
        if (f)
            f.learned = lb;
        else if (lb > 0)
            f = {
                usageCount: 0,
                learned: lb
            };
        return f;
    }

    function _stockFrecency(item) {
''')
    sc = sc.replace(a_score, a_score + "\n    usageBonus += (frecencyData && frecencyData.learned) ? frecencyData.learned : 0; // patch 19")
    backup(controller); open(controller, "w").write(c)
    backup(scorer); open(scorer, "w").write(sc)
    print("Controller.qml + Scorer.js:   patched (learned ranking, Top hit)")
    changed = True

