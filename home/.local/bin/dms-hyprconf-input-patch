#!/usr/bin/env python3
"""Let DMS Settings -> Mouse & touchpad / Keyboard work with hyprland.conf.

Symptom: the page shows "Hyprland conf mode -- This install is still using
hyprland.conf. Run dms setup to migrate before changing these settings." and
every control silently does nothing.

Cause: DMS 2.0 only writes Hyprland input settings as Lua (~/.config/hypr/
dms/input.lua, loaded via require()), which needs a Lua Hyprland config.
This machine runs Hyprland 0.53 with hyprland.conf, and a Lua config already
crashed 0.53 once (greeter), so `dms setup` migration is not an option.

Fix: when Hyprland is NOT in Lua mode, translate the exact lines DMS would
have written (inputLines / touchpadDeviceLines, so upstream logic stays the
source of truth) into hyprlang and write ~/.config/hypr/dms/input.conf, which
hyprland.conf sources after its own input block. Also:
  * Hyprland 0.53's `hyprctl -j descriptions` names options under "value",
    not "name", so DMS thought no input option was supported and wrote nothing.
  * the include check/setup for "input" greps hyprland.conf for that source
    line instead of reporting read-only.
  * the focus-follows-mouse toggle was disabled outside Lua mode.
  * input.conf is regenerated from settings.json on DMS start, like upstream
    does for input.lua.

See ~/.local/bin/dms-shell-sync for why patches go into $DMS_SHELL_DIR rather
than /usr/share.

Usage: dms-hyprconf-input-patch [shell-dir]  (default: ~/.local/share/dms-shell)
Idempotent: exit 10 means it was already in place.
"""

import os
import sys

SHELL_DIR = (sys.argv[1] if len(sys.argv) > 1
             else os.path.expanduser("~/.local/share/dms-shell"))

MARKER = "dms-hyprconf-input-patch"

EDITS = {
    "Services/HyprlandService.qml": [
        ('''                    names[option.name] = true;''',
         '''                    names[option.name ?? option.value] = true; // dms-hyprconf-input-patch: 0.53 uses "value"'''),
        ('''        if (inputGenerationPending)
            inputGenerationAction.schedule();
    }''',
         '''        if (inputGenerationPending)
            inputGenerationAction.schedule();
        // dms-hyprconf-input-patch: conf mode has no ensureDmsLuaConfigs(), so
        // write dms/input.conf from settings.json once the format is known.
        // (Ready is set just after Loading clears; the write is deferred.)
        if (!luaConfigActive)
            generateInputConfig();
    }'''),
        ('''        if (!canWriteLuaConfig("input")) {
            if (luaConfigStatusLoading || !luaConfigStatusReady)
                inputGenerationPending = true;
            return;
        }''',
         '''        if (!canWriteLuaConfig("input")) {
            if (luaConfigStatusLoading || !luaConfigStatusReady)
                inputGenerationPending = true;
            else
                doGenerateInputConfigConf();
            return;
        }'''),
        ('''    function hyprScrollMethod(method) {''',
         r'''    // Local patch (~/.local/bin/dms-hyprconf-input-patch): hyprland.conf mode.
    // Translate the Lua lines DMS would write into hyprlang dms/input.conf.
    readonly property string inputConfPath: hyprDmsDir + "/input.conf"

    function confLine(line) {
        return line.replace(/^(\s*)touchpad = \{$/, "$1touchpad {").replace(/^(\s*)\},$/, "$1}").replace(/,$/, "").replace(/\btap_to_click\b/, "tap-to-click").replace(/\btap_and_drag\b/, "tap-and-drag").replace(/= "(.*)"$/, (m, v) => "= " + v.replace(/\\"/g, "\"").replace(/\\\\/g, "\\"));
    }

    function confDeviceBlock(line) {
        const m = /^hl\.device\(\{ (.*) \}\)$/.exec(line);
        if (!m)
            return "";
        return "device {\n" + m[1].split(", ").map(f => "    " + confLine(f)).join("\n") + "\n}";
    }

    function doGenerateInputConfigConf() {
        if (!hyprOptionsReady || !hyprDevicesReady) {
            inputGenerationPending = true;
            loadHyprOptionNames();
            loadHyprTouchpads();
            return;
        }
        inputGenerationRunning = true;

        let content = "# Auto-generated by DMS (local hyprland.conf patch) -- do not edit manually\n";
        const lines = inputLines(SettingsData).map(confLine);
        if (lines.length)
            content += `\ninput {\n${lines.map(l => "    " + l.replace(/\t/g, "    ")).join("\n")}\n}\n`;
        const devices = touchpadDeviceLines(SettingsData, hyprTouchpadNames).map(confDeviceBlock).filter(b => b);
        if (devices.length)
            content += "\n" + devices.join("\n\n") + "\n";

        const path = inputConfPath;
        const script = `mkdir -p "${hyprDmsDir}" && cat > "${path}.tmp" << 'EOF'\n${content}EOF\nif cmp -s "${path}.tmp" "${path}"; then rm -f "${path}.tmp"; exit 3; fi\nmv -f "${path}.tmp" "${path}"`;
        Proc.runCommand("hypr-write-input-conf", ["sh", "-c", script], (output, exitCode) => {
            const finish = () => {
                inputGenerationRunning = false;
                if (inputGenerationPending)
                    inputGenerationAction.schedule();
            };
            if (exitCode === 3) {
                finish();
                return;
            }
            if (exitCode !== 0) {
                log.warn("Failed to write input.conf:", output);
                finish();
                return;
            }
            // Hyprland autoreloads sourced files; an explicit reload on top
            // meant two reloads per change. Only reload if autoreload is off.
            Proc.runCommand("hypr-autoreload-check", ["hyprctl", "-j", "getoption", "misc:disable_autoreload"], (out, code) => {
                let off = false;
                try {
                    off = code === 0 && JSON.parse(out).int === 1;
                } catch (e) {}
                if (off)
                    reloadConfig(finish);
                else
                    finish();
            });
        });
    }

    function hyprScrollMethod(method) {'''),
    ],
    "Modules/Settings/Widgets/ConfigInclude.qml": [
        # 2.1: readOnly is a property (drives IncludeSetupBanner's legacy
        # warning and disables its button) -- input is not read-only here.
        ('''    readonly property bool readOnly: CompositorService.isHyprland && !HyprlandService.luaConfigActive
''',
         '''    readonly property bool readOnly: CompositorService.isHyprland && !HyprlandService.luaConfigActive && !hyprConfInput // dms-hyprconf-input-patch
'''),
        ('''    function check() {
''',
         '''    // Local patch (~/.local/bin/dms-hyprconf-input-patch): in hyprland.conf mode
    // "input" is writable through a sourced dms/input.conf.
    readonly property bool hyprConfInput: includeKind === "input" && CompositorService.isHyprland && !HyprlandService.luaConfigActive
    readonly property string hyprConfFile: configDir() + "/hypr/hyprland.conf"

    function check() {
        if (hyprConfInput) {
            checking = true;
            Proc.runCommand("check-" + procTag, ["grep", "-qE", "^[[:space:]]*source[[:space:]]*=.*dms/input\\\\.conf", hyprConfFile], (output, exitCode) => {
                checking = false;
                status = {
                    "exists": true,
                    "included": exitCode === 0,
                    "configFormat": "conf",
                    "readOnly": false
                };
            });
            return;
        }
'''),
        ('''        if (readOnly) {
            showReadOnlyWarning();''',
         '''        if (hyprConfInput) {
            const dmsDir = configDir() + "/hypr/dms";
            fixing = true;
            Proc.runCommand("fix-" + procTag, ["sh", "-c", `mkdir -p "${dmsDir}" && touch "${dmsDir}/input.conf" && printf '\\\\n# DMS Settings -> Mouse & touchpad / Keyboard (dms-hyprconf-input-patch)\\\\nsource = ~/.config/hypr/dms/input.conf\\\\n' >> "${hyprConfFile}"`], (output, exitCode) => {
                fixing = false;
                check();
                if (exitCode === 0)
                    fixed();
            });
            return;
        }
        if (readOnly) {
            showReadOnlyWarning();'''),
    ],
    "Modules/Settings/MouseTouchpadTab.qml": [
        ('''(HyprlandService.luaConfigActive && HyprlandService.followMouseMode >= 0)''',
         '''(HyprlandService.followMouseMode >= 0) /* dms-hyprconf-input-patch */'''),
    ],
}


def main():
    plans = []
    for rel, edits in EDITS.items():
        path = os.path.join(SHELL_DIR, rel)
        with open(path) as f:
            src = f.read()
        if MARKER in src:
            return 10
        for old, new in edits:
            if src.count(old) != 1:
                print(f"{MARKER}: anchor not found in {path} "
                      "(DMS changed upstream?)", file=sys.stderr)
                return 1
            src = src.replace(old, new)
        plans.append((path, src))
    for path, src in plans:
        with open(path, "w") as f:
            f.write(src)
        print(f"{MARKER}: patched {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
