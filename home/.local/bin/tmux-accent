#!/usr/bin/env bash
# Regenerate tmux's accent-derived colours from the live GTK accent.
#
# Same source of truth as accent.conf, the DMS palette, pulsar-accent and
# ghostty-accent: accent-resolve.py --print. Called from hypr-accent. Writes a
# generated fragment that ~/.config/tmux/tmux.conf sources, then re-sources
# the config in a running server so open sessions repaint in place.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')

read -r ink dim <<EOF
$(/usr/bin/python3 - "$hex" <<'PY'
import sys
h = sys.argv[1]
r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
# Text drawn on top of the accent: pick whichever of white / near-black
# gives more WCAG contrast, so a pale accent never ends up with white text.
lin = lambda c: (c / 255) / 12.92 if c <= 10 else (((c / 255) + 0.055) / 1.055) ** 2.4
L = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
ink = 'FFFFFF' if (1.05 / (L + 0.05)) >= ((L + 0.05) / (0.0262 + 0.05)) else '1F1F1F'
# 0.70 toward the terminal background #1F1F1F: inactive window tabs.
mix = lambda c, t, w: round(c * (1 - w) + t * w)
dim = '%02X%02X%02X' % tuple(mix(c, 0x1F, 0.70) for c in (r, g, b))
print(ink, dim)
PY
)
EOF

install -d "$HOME/.config/tmux"

cat > "$HOME/.config/tmux/accent.conf" <<EOF
# GENERATED by tmux-accent -- edits are lost on the next run.
set -g @accent     "#$hex"
set -g @accent_ink "#$ink"
set -g @accent_dim "#$dim"
EOF

if tmux info >/dev/null 2>&1; then
    tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
fi
echo "tmux accent #$hex  ink #$ink  dim #$dim"
