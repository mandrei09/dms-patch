#!/usr/bin/env bash
# Regenerate Pulsar's accent-derived colours from the live GTK accent.
#
# A consumer of the same source of truth as accent.conf and the DMS palette:
# accent-resolve.py --print, which reads the GTK theme's own
# @define-color theme_selected_bg_color. Called from hypr-accent, so switching
# accent in GNOME Settings repaints Pulsar along with everything else.
#
# Rewrites only the marked region of ~/.pulsar/styles.less. The rest of that
# file -- the VS Code Dark Modern greys and token colours -- is hand-written
# and must survive. Deliberately NOT a separate @import: a failed import takes
# the whole user stylesheet down, and Pulsar reports that only in devtools.
set -euo pipefail

SYNC="$HOME/.local/bin/accent-resolve.py"
STYLES="$HOME/.pulsar/styles.less"
[ -f "$STYLES" ] || { echo "pulsar-accent: no $STYLES" >&2; exit 0; }

hex=$(/usr/bin/python3 "$SYNC" --print | tr -d '#[:space:]')

/usr/bin/python3 - "$hex" "$STYLES" <<'PY'
import pathlib, re, sys

hex_, styles = sys.argv[1], pathlib.Path(sys.argv[2])
r, g, b = (int(hex_[i:i+2], 16) for i in (0, 2, 4))
mix = lambda c, t, w: round(c * (1 - w) + t * w)
H = lambda t: '#%02x%02x%02x' % t

# Same 0.45-toward-black step hypr-accent uses for $accentDim, so the editor
# and the window borders share a gradient.
dim = H(tuple(mix(c, 0x00, 0.45) for c in (r, g, b)))
# Selected rows: accent pulled most of the way into the #181818 chrome, the
# role VS Code fills with list.activeSelectionBackground.
sel = H(tuple(mix(c, 0x18, 0.72) for c in (r, g, b)))
hov = H(tuple(mix(c, 0x18, 0.86) for c in (r, g, b)))
# Lifted toward white for text on dark, where the raw accent is too dim.
txt = H(tuple(mix(c, 0xff, 0.25) for c in (r, g, b)))
# Editor selection: the accent pulled toward the #1f1f1f editor background by
# enough to land on the same perceived lightness as Dark Modern's own
# selection #264f78 (luma ~71 by 0.3/0.59/0.11). Using the raw accent-dim
# instead reads as a highlighter pen behind the text.
sel_edit = H(tuple(mix(c, 0x1f, 0.52) for c in (r, g, b)))

block = f"""// >>> ACCENT -- GENERATED by pulsar-accent, edits are lost on the next run.
// Source: accent-resolve.py --print (the GTK theme's theme_selected_bg_color),
// the same value behind $accent in ~/.config/hypr/accent.conf.
// Dark Modern's own accent is #0078d4 blue; the system accent replaces it so
// Pulsar matches the desktop rather than VS Code.
@accent:        #{hex_.lower()};
@accent-dim:    {dim};
@accent-text:   {txt};
@list-active:   {sel};
@list-hover:    {hov};
@selection:     {sel_edit};
// <<< ACCENT"""

s = styles.read_text()
pat = re.compile(r"// >>> ACCENT.*?// <<< ACCENT", re.S)
if pat.search(s):
    s = pat.sub(block, s)
else:
    raise SystemExit("pulsar-accent: marker region not found in styles.less")
styles.write_text(s)
print(f"pulsar accent #{hex_.lower()}  dim {dim}  sel {sel}")
PY
